# Ignore everything by default
*

# But keep the ignore file itself
!.gitignore

# Keep a small repo-level README
!README.md

# Entry point for running under /checklist/ on localhost
!index.html

# Keep the checklist folder (core code)
!checklist/
!checklist/**

# Keep tools (helpers, scripts)
!tools/
!tools/**

# Keep docs (design specs, architecture)
!docs/
!docs/**
